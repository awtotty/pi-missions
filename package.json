{
  "name": "pi-missions",
  "version": "0.1.0",
  "description": "Unofficial pi port of Factory-style long-running mission orchestration.",
  "type": "module",
  "keywords": ["pi-package", "pi", "missions", "orchestration"],
  "license": "MIT",
  "files": [
    "README.md",
    "LICENSE",
    "extensions/",
    "skills/",
    "prompts/",
    "scripts/",
    "docs/",
    "tsconfig.json"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*",
    "typescript": "^5.9.0"
  },
  "pi": {
    "extensions": ["./extensions/missions/index.ts"],
    "skills": ["./skills"],
    "prompts": ["./prompts"]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate:f1": "node ./scripts/validate-f1-mission-control-pane-model.mjs",
    "validate:f3": "node ./scripts/validate-f3-runner-command-routing.mjs",
    "validate:f3-nav": "node ./scripts/validate-f3-mission-control-navigation.mjs",
    "validate:f4": "node ./scripts/validate-f4-mission-flow-coverage.mjs",
    "validate:f4-ux": "node ./scripts/validate-f4-mission-control-activity-output.mjs",
    "validate:f5": "node ./scripts/validate-f5-official-orchestrator-session.mjs",
    "validate:f5-ux": "node ./scripts/validate-f5-mission-control-ux-regression.mjs",
    "validate:f7": "node ./scripts/validate-f7-mission-control-runner-wiring.mjs",
    "validate:f8": "node ./scripts/validate-f8-feature-execution-vs-milestones.mjs",
    "validate:f9": "node ./scripts/validate-f9-recovery-protocol.mjs",
    "validate:f10": "node ./scripts/validate-f10-simulation-harness.mjs"
  }
}
